{
  "expo": {
    "name": "Leevon Delivery",
    "slug": "customerreactnative",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/App Icon.png",
    "notification": {
      "icon": "./assets/images/logo.png",
      "color": "#2B783E"
    },
    "scheme": "customerreactnative",
    "userInterfaceStyle": "light",
    "statusBar": {
      "style": "dark",
      "backgroundColor": "#F9F9F6"
    },
    "ios": {
      "icon": "./assets/images/App Icon.png",
      "bundleIdentifier": "com.leevondelivery.customer"
    },
    "android": {
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.leevon.delivery",
      "versionCode": 2,
      "usesCleartextTraffic": true,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo.png",
          "color": "#2B783E"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 200
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow this app to access your microphone for voice search",
          "speechRecognitionPermission": "Allow this app to recognize your speech for voice search"
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "@react-native-firebase/app",
        {
          "notification_icon": "./assets/images/logo.png"
        }
      ],
      "@react-native-firebase/auth",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2e6ebf6b-5d5c-4aeb-865a-cbc740baea75"
      }
    }
  }
}
